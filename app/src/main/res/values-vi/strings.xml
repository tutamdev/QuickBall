    <string name="rate_dialog_title">Lời nhắn từ nhà phát triển ❤️</string>
    <string name="rate_dialog_p1">Xin chào, mình là người làm ra %1$s.</string>
    <string name="rate_dialog_p2">Mình tự phát triển ứng dụng này — tính năng, cải tiến và sửa lỗi — trong thời gian rảnh. Sự ủng hộ của bạn là động lực để mình tiếp tục làm %1$s tốt hơn.</string>
    <string name="rate_dialog_p3">Nếu có gì không hoạt động hoặc bạn muốn thêm tính năng, hãy email cho mình. Mình đọc mọi tin nhắn và sẽ cố gắng hỗ trợ nhanh nhất.</string>
    <string name="rate_dialog_p4">Nếu bạn thích %1$s, một đánh giá 5★ sẽ rất có ý nghĩa. Chỉ mất một phút nhưng giúp nhiều người biết đến ứng dụng hơn.</string>
    <string name="rate_dialog_thank_you">Cảm ơn bạn đã dùng %1$s và ủng hộ mình.</string>
    <string name="rate_dialog_signature">Chayan</string>
