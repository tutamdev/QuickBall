    <string name="huawei_guide_header">Thiết lập cho Huawei / HarmonyOS</string>
    <string name="generic_guide_header">Thiết lập để chạy nền ổn định</string>
    <string name="huawei_detected">Phát hiện: %1$s · %2$s</string>
    <string name="guide_step_app_launch">Khởi chạy ứng dụng → Quick Ball → Quản lý thủ công → bật Tự khởi chạy, Khởi chạy phụ và Chạy trong nền.</string>
    <string name="guide_step_battery">Tối ưu hóa pin → Tất cả ứng dụng → Quick Ball → Không cho phép.</string>
    <string name="guide_step_recents">Nếu bạn giữ Quick Ball trong Gần đây thay vì ẩn, hãy kéo thẻ của nó xuống để khóa.</string>
    <string name="guide_step_accessibility">Trợ năng → Quick Ball → Bật (kiểm tra lại sau mỗi lần cập nhật).</string>
    <string name="guide_step_tile">Thêm ô Quick Ball vào Cài đặt nhanh để khôi phục bằng một chạm.</string>
    <string name="guide_limitations">Ứng dụng không thể thay đổi các thiết lập này của Huawei. Nếu Quick Ball bị buộc dừng, hệ thống sẽ tắt dịch vụ trợ năng của nó — mở Quick Ball (hoặc chạm ô cài đặt nhanh) để bật lại.</string>

