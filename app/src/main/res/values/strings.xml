    <string name="huawei_guide_header">Huawei / HarmonyOS setup</string>
    <string name="generic_guide_header">Setup for reliable background use</string>
    <string name="huawei_detected">Detected: %1$s · %2$s</string>
    <string name="guide_step_app_launch">App launch → Quick Ball → Manage manually → turn on Auto-launch, Secondary launch and Run in background.</string>
    <string name="guide_step_battery">Battery optimization → All apps → Quick Ball → Don\'t allow.</string>
    <string name="guide_step_recents">If you keep Quick Ball in Recents instead of hiding it, swipe its card down to lock it.</string>
    <string name="guide_step_accessibility">Accessibility → Quick Ball → On (re-check after updates).</string>
    <string name="guide_step_tile">Add the Quick Ball tile to Quick Settings for one-tap recovery.</string>
    <string name="guide_limitations">These Huawei settings can\'t be changed by apps. If Quick Ball is force-stopped, the system turns its accessibility service off — open Quick Ball (or tap the tile) to turn it back on.</string>

