    <!-- Onboarding & Permissions -->
    <string name="onboarding_title">Meet Quick Ball</string>
    <string name="onboarding_subtitle">A floating button that puts one-handed navigation and quick actions anywhere on your screen. It never reads screen content, and nothing leaves your device.</string>
    <string name="onboarding_bullet_1">Home, Back, Recents and more from a fan menu you design</string>
    <string name="onboarding_bullet_2">Swipe gestures, media controls and one-tap shortcuts</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_permissions_title">Permissions</string>
    <string name="onboarding_permissions_subtitle">Quick Ball needs just these two to run. Anything else is asked for only when you turn on a feature that needs it.</string>
    <string name="onboarding_accessibility_title">Accessibility</string>
    <string name="onboarding_accessibility_description">Powers the floating button and lets Quick Ball perform navigation actions like Home, Back and Recents. It never reads screen content.</string>
    <string name="onboarding_system_settings_description">Lets Quick Ball adjust system settings like screen brightness and volume directly from the floating menu.</string>
    <string name="onboarding_permissions_warning">Quick Ball needs Accessibility and System Settings permissions to work properly.</string>
